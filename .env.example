# Hari Automobiles Environment Configuration
# Copy this file to .env.local and fill in the values as needed

# Application Environment
VITE_APP_NAME=Hari Automobiles
VITE_APP_URL=https://hari-automobiles.com

# Contact Information
VITE_PHONE=+919845352109
VITE_EMAIL=contact@hari-automobiles.com

# Location
VITE_LOCATION_LATITUDE=13.065171
VITE_LOCATION_LONGITUDE=77.685324
VITE_LOCATION_ADDRESS=Kada Agrahara Main Road, Bangalore 560077

# Form Submission (FormSubmit.co)
# Get your endpoint from https://formsubmit.co
VITE_FORM_ENDPOINT=https://formsubmit.co/your-email@example.com

# Analytics (Optional)
VITE_GOOGLE_ANALYTICS_ID=

# Note: Environment variables must be prefixed with VITE_ to be accessible in the browser
# Never commit .env.local to version control
